# Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — only .env.example is committed.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL="postgresql://user:password@localhost:5432/paymentandsubscriptionslice"

# Node environment
# NODE_ENV="development"

# Public app URL
# APP_URL="http://localhost:3000"

# SMTP (optional — when unset, Ethereal test accounts are used in development)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_FROM="PaymentSlice <noreply@example.com>"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"

# Flutterwave Test Keys
# FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxx"
# FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxx"
# FLUTTERWAVE_WEBHOOK_SECRET="your-webhook-secret-hash"
